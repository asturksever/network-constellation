{
  "name": "network-constellation",
  "version": "0.1.0",
  "description": "A 3D force-directed view of your LinkedIn connections, clustered by what people do.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "python3 -m http.server 8080",
    "bundle": "node scripts/bundle.mjs",
    "vendor": "mkdir -p vendor && curl -sL https://cdn.jsdelivr.net/npm/3d-force-graph@1.80.0/dist/3d-force-graph.min.js -o vendor/3d-force-graph.min.js",
    "logos": "node scripts/fetch-logos.mjs",
    "check": "for f in src/*.js scripts/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test \"test/*.test.mjs\""
  }
}
